// Line icons on a 24-unit grid, drawn as stroked paths so they follow the theme.

import { Theme } from "theme.slint";

export component Icon inherits Path {
    in property <string> name;
    in property <color> color: Theme.text;
    in property <length> size: 20px;
    in property <length> weight: 1.8px;
    width: root.size;
    height: root.size;
    viewbox-width: 24;
    viewbox-height: 24;
    fill: transparent;
    stroke: root.color;
    stroke-width: root.weight;
    stroke-line-cap: round;
    stroke-line-join: round;
    accessible-role: none;
    commands: root.name == "search" ? "M11 4.5a6.5 6.5 0 1 0 0 13a6.5 6.5 0 1 0 0-13zM16 16l4.5 4.5"
        : root.name == "plus" ? "M12 5v14M5 12h14"
        : root.name == "close" ? "M6 6l12 12M18 6L6 18"
        : root.name == "panel" ? "M5.5 4.5h13a2 2 0 0 1 2 2v11a2 2 0 0 1-2 2h-13a2 2 0 0 1-2-2v-11a2 2 0 0 1 2-2zM14.5 4.5v15"
        : root.name == "person" ? "M12 5a3.5 3.5 0 1 0 0 7a3.5 3.5 0 1 0 0-7zM5 20c.8-3.6 3.6-5.5 7-5.5s6.2 1.9 7 5.5"
        : root.name == "sliders" ? "M4 7h10M18 7h2M4 17h4M12 17h8M16 5a2 2 0 1 0 0 4a2 2 0 1 0 0-4zM10 15a2 2 0 1 0 0 4a2 2 0 1 0 0-4z"
        : root.name == "logout" ? "M10 4H6a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h4M15 8l4 4-4 4M19 12H9"
        : root.name == "shield" ? "M12 3l7 3v5.5c0 4.3-3 7.9-7 9.5-4-1.6-7-5.2-7-9.5V6zM8.8 12.2l2.2 2.2 4.2-4.4"
        : root.name == "chevron-right" ? "M9.5 6l6 6-6 6"
        : root.name == "arrow-up" ? "M12 19V5M5.5 11.5L12 5l6.5 6.5"
        : root.name == "note" ? "M7 3h10a1.5 1.5 0 0 1 1.5 1.5v15A1.5 1.5 0 0 1 17 21H7a1.5 1.5 0 0 1-1.5-1.5v-15A1.5 1.5 0 0 1 7 3zM9 8h6M9 12h6M9 16h4"
        : root.name == "monitor" ? "M5 4.5h14a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-8a2 2 0 0 1 2-2zM8.5 20h7M12 16.5V20"
        : root.name == "file" ? "M7 3h7l5 5v11a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2zM14 3v5h5"
        : root.name == "pin" ? "M9 4h6l-1 5 3 3v2H7v-2l3-3zM12 14v6"
        : root.name == "eye" ? "M2.5 12s3.5-6.5 9.5-6.5 9.5 6.5 9.5 6.5-3.5 6.5-9.5 6.5S2.5 12 2.5 12zM12 9a3 3 0 1 0 0 6a3 3 0 1 0 0-6z"
        : root.name == "chats" ? "M4 5.5h11A1.5 1.5 0 0 1 16.5 7v6a1.5 1.5 0 0 1-1.5 1.5H9l-3.5 3v-3H4A1.5 1.5 0 0 1 2.5 13V7A1.5 1.5 0 0 1 4 5.5zM19 9h.5a1.5 1.5 0 0 1 1.5 1.5v6a1.5 1.5 0 0 1-1.5 1.5H19v3l-3.5-3H12"
        : root.name == "check" ? "M5 12.5l4.5 4.5L19 7.5"
        : root.name == "cpu" ? "M8 6h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2zM10 9.5h4a.5.5 0 0 1 .5.5v4a.5.5 0 0 1-.5.5h-4a.5.5 0 0 1-.5-.5v-4a.5.5 0 0 1 .5-.5zM9 3v3M15 3v3M9 18v3M15 18v3M3 9h3M3 15h3M18 9h3M18 15h3"
        : root.name == "book" ? "M5 4.5A1.5 1.5 0 0 1 6.5 3H19v15H6.5A1.5 1.5 0 0 0 5 19.5zM5 19.5A1.5 1.5 0 0 0 6.5 21H19"
        : root.name == "chevron-left" ? "M14.5 6l-6 6 6 6"
        : root.name == "eye-off" ? "M3 3l18 18M10.6 10.6a2 2 0 0 0 2.8 2.8M9.9 5.6A9.5 9.5 0 0 1 12 5.5c6 0 9.5 6.5 9.5 6.5a17 17 0 0 1-3.1 3.9M6.6 6.6C3.9 8.4 2.5 12 2.5 12s3.5 6.5 9.5 6.5a9.4 9.4 0 0 0 4.5-1.1"
        : root.name == "alert" ? "M12 3l7 3v5.5c0 4.3-3 7.9-7 9.5-4-1.6-7-5.2-7-9.5V6zM12 8.5v4.5M12 16.2h.01"
        : root.name == "quiz" ? "M5 4.5h14a1.5 1.5 0 0 1 1.5 1.5v12a1.5 1.5 0 0 1-1.5 1.5H5A1.5 1.5 0 0 1 3.5 18V6A1.5 1.5 0 0 1 5 4.5zM7.5 12l2.5 2.5 6.5-6.5"
        : root.name == "pause" ? "M9 6v12M15 6v12"
        : root.name == "play" ? "M8 5.5v13l10.5-6.5z"
        : root.name == "key" ? "M8 11a4 4 0 1 0 0 8a4 4 0 1 0 0-8zM11 12l8-8M16 7l2 2M14 9l2 2"
        : root.name == "list" ? "M8 6h12M8 12h12M8 18h12M4 6h.01M4 12h.01M4 18h.01"
        : root.name == "blocks" ? "M5.5 4h4A1.5 1.5 0 0 1 11 5.5v4A1.5 1.5 0 0 1 9.5 11h-4A1.5 1.5 0 0 1 4 9.5v-4A1.5 1.5 0 0 1 5.5 4zM14.5 4h4A1.5 1.5 0 0 1 20 5.5v4a1.5 1.5 0 0 1-1.5 1.5h-4A1.5 1.5 0 0 1 13 9.5v-4A1.5 1.5 0 0 1 14.5 4zM5.5 13h4a1.5 1.5 0 0 1 1.5 1.5v4A1.5 1.5 0 0 1 9.5 20h-4A1.5 1.5 0 0 1 4 18.5v-4A1.5 1.5 0 0 1 5.5 13zM16.5 13v7M13 16.5h7"
        : root.name == "clock" ? "M12 3.5a8.5 8.5 0 1 0 0 17a8.5 8.5 0 1 0 0-17zM12 7.5V12l3 2"
        : root.name == "copy" ? "M10.5 8.5h7a2 2 0 0 1 2 2v7a2 2 0 0 1-2 2h-7a2 2 0 0 1-2-2v-7a2 2 0 0 1 2-2zM15.5 8.5V6.5a2 2 0 0 0-2-2h-7a2 2 0 0 0-2 2v7a2 2 0 0 0 2 2h2"
        : "";
}

// The snowpaw paw print (from design/icon/paw.svg), filled.
export component PawMark inherits Path {
    in property <color> color: Theme.accent;
    in property <length> size: 24px;
    // A square box around the whole paw (its outline spans 133..891 x 165..838 of the
    // 1024-unit drawing), so the toes are never cut off and every size lines up.
    width: root.size;
    height: root.size;
    viewbox-x: 117;
    viewbox-y: 106;
    viewbox-width: 790;
    viewbox-height: 790;
    fill: root.color;
    stroke-width: 0;
    accessible-role: none;
    commands: "M306.72 298.59a90.52 107.76-18.58 0 1 171.6-57.68 90.52 133.62-18.58 0 1-171.6 57.68M545.68 240.91a90.52 107.76 18.58 0 1 171.6 57.68 90.52 133.62 18.58 0 1-171.6-57.68M175.96 478.78a77.59 94.83-54.24 0 1 90.7-125.91 77.59 116.38-54.24 0 1-90.7 125.91M757.34 352.87a77.59 94.83 54.24 0 1 90.7 125.91 77.59 116.38 54.24 0 1-90.7-125.91M512 431.23a193.97 193.97 0 0 1 144.15 64.18c58.4 64.87 104.13 172.46 104.13 250.05 0 81.47-38.8 93.1-124.14 93.1-58.19 0-100.86-11.63-124.14-17.45-23.28 5.82-65.95 17.45-124.14 17.45-85.34 0-124.14-11.63-124.14-93.1 0-77.59 45.73-185.18 104.13-250.05A193.97 193.97 0 0 1 512 431.23";
}

// The snowpaw wordmark: the paw and the name, in the same proportions everywhere.
export component Wordmark inherits HorizontalLayout {
    // Height of the paw; the name is sized from it.
    in property <length> size: 22px;
    in property <color> paw: Theme.accent;
    in property <color> ink: Theme.text;
    spacing: root.size * 0.4;
    accessible-role: text;
    accessible-label: "snowpaw";
    VerticalLayout {
        alignment: center;
        PawMark {
            size: root.size;
            color: root.paw;
        }
    }
    Text {
        text: "snowpaw";
        color: root.ink;
        font-size: root.size * 0.8;
        font-weight: 700;
        letter-spacing: -0.2px;
        vertical-alignment: center;
        accessible-role: none;
    }
}
