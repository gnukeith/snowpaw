// The right column: who the chat is with, and the Details / Library / Computer tabs.

import { Theme, Metrics, TextSize } from "theme.slint";
import { Icon } from "icons.slint";
import { ChatRow, Conversation, Person } from "types.slint";
import { Pressable, IconButton, Button, Avatar, ChatAvatar, SectionLabel, Segmented } from "components.slint";
import { JobCard } from "jobs.slint";

component PersonRow inherits HorizontalLayout {
    in property <Person> person;
    spacing: 12px;
    padding-left: 14px;
    padding-right: 14px;
    height: 52px;
    VerticalLayout {
        alignment: center;
        Avatar {
            person: root.person;
            size: 32px;
            surface: Theme.raised;
        }
    }
    Text {
        text: root.person.name;
        color: Theme.text;
        font-size: TextSize.small;
        font-weight: 600;
        vertical-alignment: center;
        overflow: elide;
        horizontal-stretch: 1;
    }
    Text {
        text: root.person.kind == "me" ? "You" : (root.person.kind == "agent" ? "Agent" : "");
        color: Theme.secondary;
        font-size: TextSize.caption;
        vertical-alignment: center;
    }
}

component RelatedRow inherits Pressable {
    in property <ChatRow> chat;
    label: root.chat.title + ". Open the conversation";
    height: 60px;
    border-radius: Metrics.radius-control;
    background: root.pressed ? Theme.selected : (root.hovered ? Theme.hover : transparent);
    border-width: root.focused ? 2px : 0px;
    border-color: Theme.accent;
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 12px;
        VerticalLayout {
            alignment: center;
            ChatAvatar {
                people: root.chat.people;
                size: 36px;
                surface: root.hovered ? Theme.hover : Theme.raised;
            }
        }
        VerticalLayout {
            alignment: center;
            spacing: 1px;
            horizontal-stretch: 1;
            Text {
                text: root.chat.title;
                color: Theme.text;
                font-size: TextSize.small;
                font-weight: 600;
                overflow: elide;
            }
            Text {
                text: root.chat.preview;
                color: Theme.secondary;
                font-size: TextSize.caption;
                overflow: elide;
            }
        }
        VerticalLayout {
            alignment: center;
            Icon {
                name: "chevron-right";
                size: 16px;
                color: Theme.secondary;
            }
        }
    }
}

// A rounded group of rows.
component Card inherits Rectangle {
    border-radius: Metrics.radius-card;
    background: Theme.raised;
    VerticalLayout {
        padding-top: 4px;
        padding-bottom: 4px;
        @children
    }
}

component EmptyCard inherits Rectangle {
    in property <string> icon;
    in property <string> text;
    border-radius: Metrics.radius-card;
    border-width: 1px;
    border-color: Theme.line;
    VerticalLayout {
        padding: 24px;
        spacing: 10px;
        HorizontalLayout {
            alignment: center;
            Icon {
                name: root.icon;
                size: 24px;
                color: Theme.secondary;
            }
        }
        Text {
            text: root.text;
            color: Theme.secondary;
            font-size: TextSize.small;
            horizontal-alignment: center;
            wrap: word-wrap;
        }
    }
}

export component DetailsPanel inherits Rectangle {
    in property <Conversation> chat;
    in-out property <int> tab;
    callback close();
    callback open-chat(string);
    callback toggle-pin(string);
    callback edit-agent();
    callback new-job();
    callback approve-job(string);
    callback cancel-job(string);
    callback run-job(string);

    property <string> name: root.chat.people.length == 1 ? root.chat.people[0].name : root.chat.title;
    background: Theme.side;

    // Note to Self and agent-to-agent chats have no Computer tab.
    changed chat => {
        if (!root.chat.agent && root.tab == 2) {
            root.tab = 0;
        }
    }

    VerticalLayout {
        HorizontalLayout {
            height: Metrics.header-height;
            padding-right: 14px;
            alignment: end;
            VerticalLayout {
                alignment: center;
                IconButton {
                    icon: "close";
                    label: "Close chat details";
                    clicked => {
                        root.close();
                    }
                }
            }
        }

        flick := Flickable {
            vertical-stretch: 1;
            content-height: content.preferred-height;
            content := VerticalLayout {
                width: flick.width;
                padding-left: 20px;
                padding-right: 20px;
                padding-bottom: 28px;
                spacing: 18px;

                // Who.
                VerticalLayout {
                    spacing: 6px;
                    HorizontalLayout {
                        alignment: center;
                        ChatAvatar {
                            people: root.chat.people;
                            size: 96px;
                        }
                    }
                    Text {
                        text: root.chat.title;
                        color: Theme.text;
                        font-size: TextSize.title;
                        font-weight: 700;
                        horizontal-alignment: center;
                        wrap: word-wrap;
                    }
                    Text {
                        text: root.chat.agent && root.chat.people[0].label != "" ? root.chat.people[0].label : root.chat.subtitle;
                        color: Theme.secondary;
                        font-size: TextSize.caption;
                        horizontal-alignment: center;
                        wrap: word-wrap;
                    }
                }

                if !root.chat.read-only: HorizontalLayout {
                    alignment: center;
                    spacing: 8px;
                    if root.chat.agent: Button {
                        kind: "secondary";
                        icon: "sliders";
                        text: "Edit";
                        clicked => {
                            root.edit-agent();
                        }
                    }
                    Button {
                        kind: "secondary";
                        icon: "pin";
                        text: root.chat.pinned ? "Unpin" : "Pin to top";
                        clicked => {
                            root.toggle-pin(root.chat.id);
                        }
                    }
                }

                Segmented {
                    items: root.chat.agent ? ["Details", "Library", "Computer"] : ["Details", "Library"];
                    current: root.tab;
                    picked(i) => {
                        root.tab = i;
                    }
                }

                // Details.
                if root.tab == 0 && root.chat.note: Text {
                    text: "Only you can see this chat. Notes and files you keep here show up in every snowpaw window you’re logged in to.";
                    color: Theme.secondary;
                    font-size: TextSize.small;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }
                if root.tab == 0 && root.chat.read-only: VerticalLayout {
                    spacing: 8px;
                    HorizontalLayout {
                        padding-left: 6px;
                        SectionLabel {
                            text: "IN THIS CHAT";
                        }
                    }
                    Card {
                        for p in root.chat.people: PersonRow {
                            person: p;
                        }
                    }
                }
                // A new agent still needs a model and a running runtime: say what's left.
                if root.tab == 0 && root.chat.agent && root.chat.setup.loaded && (!root.chat.setup.has-model || !root.chat.setup.connected): Rectangle {
                    border-radius: Metrics.radius-card;
                    border-width: 1px;
                    border-color: Theme.strong;
                    VerticalLayout {
                        padding: 16px;
                        spacing: 10px;
                        Text {
                            text: "Finish setting up " + root.name;
                            color: Theme.text;
                            font-size: TextSize.body;
                            font-weight: 700;
                        }
                        for item in [
                            { done: root.chat.setup.has-model, text: "Choose a model" },
                            { done: root.chat.setup.token-issued != "", text: "Get a runtime token" },
                            { done: root.chat.setup.connected, text: "Start the runtime" },
                        ]: HorizontalLayout {
                            spacing: 10px;
                            height: 26px;
                            VerticalLayout {
                                alignment: center;
                                Rectangle {
                                    width: 20px;
                                    height: 20px;
                                    border-radius: 10px;
                                    background: item.done ? Theme.accent-fill : transparent;
                                    border-width: item.done ? 0px : 2px;
                                    border-color: Theme.strong;
                                    if item.done: Icon {
                                        x: 3px;
                                        y: 3px;
                                        size: 14px;
                                        weight: 2.4px;
                                        name: "check";
                                        color: Theme.on-accent;
                                    }
                                }
                            }
                            Text {
                                text: item.text;
                                color: item.done ? Theme.secondary : Theme.text;
                                font-size: TextSize.small;
                                vertical-alignment: center;
                            }
                        }
                        HorizontalLayout {
                            alignment: start;
                            Button {
                                text: "Open settings";
                                clicked => {
                                    root.edit-agent();
                                }
                            }
                        }
                    }
                }
                if root.tab == 0 && root.chat.agent && root.chat.about != "": Text {
                    text: root.chat.about;
                    color: Theme.text;
                    font-size: TextSize.small;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }
                if root.tab == 0 && root.chat.agent: VerticalLayout {
                    spacing: 8px;
                    HorizontalLayout {
                        padding-left: 6px;
                        SectionLabel {
                            text: "JOBS";
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }
                        Button {
                            kind: "quiet";
                            icon: "plus";
                            text: "New job";
                            clicked => {
                                root.new-job();
                            }
                        }
                    }
                    if root.chat.jobs.length == 0: Text {
                        text: "No jobs yet. A job is something " + root.name + " does on its own at times you choose, like a morning summary.";
                        width: root.width - 40px;
                        color: Theme.secondary;
                        font-size: TextSize.small;
                        wrap: word-wrap;
                    }
                    for job in root.chat.jobs: JobCard {
                        width: root.width - 40px;
                        job: job;
                        agent: root.name;
                        approve(id) => {
                            root.approve-job(id);
                        }
                        cancel(id) => {
                            root.cancel-job(id);
                        }
                        run-now(id) => {
                            root.run-job(id);
                        }
                    }
                }
                if root.tab == 0 && root.chat.agent: VerticalLayout {
                    spacing: 8px;
                    HorizontalLayout {
                        padding-left: 6px;
                        SectionLabel {
                            text: "WITH OTHER AGENTS";
                        }
                    }
                    if root.chat.related.length > 0: Card {
                        for c in root.chat.related: RelatedRow {
                            chat: c;
                            clicked => {
                                root.open-chat(c.id);
                            }
                        }
                    }
                    if root.chat.related.length == 0: Text {
                        text: root.name + " hasn’t talked to other agents yet.";
                        color: Theme.secondary;
                        font-size: TextSize.small;
                        wrap: word-wrap;
                    }
                }
                if root.tab == 0 && root.chat.read-only: Text {
                    text: "You’re reading along. Only these agents can write here.";
                    color: Theme.secondary;
                    font-size: TextSize.small;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }

                // Library: files from this chat.
                if root.tab == 1: EmptyCard {
                    icon: "file";
                    text: root.chat.note ? "Nothing here yet. Files you keep in Note to Self will show up here." : "Nothing here yet. Files " + root.name + " makes for you will show up here.";
                }

                // Computer: a view-only picture of the agent's screen.
                if root.tab == 2 && root.chat.agent: VerticalLayout {
                    spacing: 10px;
                    Rectangle {
                        height: self.width * 10 / 16;
                        border-radius: Metrics.radius-card;
                        border-width: 1px;
                        border-color: Theme.line;
                        background: Theme.screen;
                        VerticalLayout {
                            alignment: center;
                            spacing: 8px;
                            HorizontalLayout {
                                alignment: center;
                                Icon {
                                    name: "monitor";
                                    size: 28px;
                                    color: Theme.secondary;
                                }
                            }
                            Text {
                                text: !root.chat.setup.connected ? "The runtime isn’t running" : (root.chat.people[0].working ? "Working on a reply" : "Idle");
                                color: root.chat.people[0].working ? Theme.accent : Theme.secondary;
                                font-size: TextSize.caption;
                                font-weight: root.chat.people[0].working ? 600 : 400;
                                horizontal-alignment: center;
                            }
                        }
                    }
                    Text {
                        text: root.name + "’s screen · view only";
                        color: Theme.secondary;
                        font-size: TextSize.caption;
                        horizontal-alignment: center;
                    }
                }
            }
        }
    }
}
